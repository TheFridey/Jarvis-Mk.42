%% Which component owns which store. One owner (writer) per category.
%% Full table: ../DATA_OWNERSHIP.md
flowchart LR
    subgraph OWNERS["Kernel components (sole writers)"]
        IDN[Identity Manager]
        SES[Session Manager]
        EVT[Event Manager]
        STATE[State Manager]
        OBJ[Objective Engine]
        SCHED[Scheduler]
        PERM[Permission Engine]
        POL[Policy Engine]
        CAPR[Capability Registry]
        MODR[Model Registry]
        AGRT[Agent Runtime]
        PRES[Presence Manager]
        NOTIF[Notification Manager]
        HLTH[Health Manager]
        AUD[Audit Manager]
        SCN[Scene service]
        WMS[World Model service]
        MEMS[Memory service]
    end

    IDN --> D1[(PG identity.*)]
    SES --> D2[(PG session.sessions)]
    SES --> R1[(Redis: session liveness)]
    EVT --> D3[(PG events — ledger)]
    STATE --> D4[(PG projections.* — current values)]
    OBJ --> D4
    SCHED --> D5[(PG projections.tasks)]
    SCHED --> R2[(Redis: dispatch/leases)]
    PERM --> D6[(PG projections.grants + events)]
    PERM --> R3[(Redis: authority tokens TTL)]
    POL --> D7[(PG policy.rules — versioned)]
    CAPR --> D8[(PG catalogue.capabilities)]
    MODR --> D9[(PG catalogue.models)]
    AGRT --> D10[(PG projections.agent_runs)]
    PRES --> D11[(PG projections.nodes — registry)]
    PRES --> R4[(Redis: node liveness + presence-current)]
    NOTIF --> D12[(PG projections.notifications)]
    HLTH --> R5[(Redis: health-current)]
    AUD --> D13[(PG audit.* — append-only)]
    SCN --> D14[(PG scene.* durable placement)]
    SCN --> R6[(Redis: live positions)]
    WMS --> D15[(PG world_model.* — beliefs w/ provenance)]
    MEMS --> D16[(PG memory.* + pgvector)]

    note1>PostgreSQL is authority behind everything.\nRedis only caches reconstructible data.\nNo component reads another's schema — events or interface calls only.]
