{
  "name": "jarvis",
  "version": "0.43.0",
  "productRelease": "RC1.2",
  "private": true,
  "description": "JARVIS MK.42 - a persistent, event-driven AI operating layer. MK.43 phase: the Nervous System.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "setup:check": "node scripts/check-setup.mjs",
    "assets:check": "node scripts/check-preserved-assets.mjs",
    "deps:audit": "node scripts/audit-dependencies.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-it.mjs",
    "test:contract": "node scripts/run-gate.mjs contract",
    "test:security": "node scripts/run-gate.mjs security",
    "fitness": "node scripts/run-gate.mjs fitness",
    "test:chaos": "node scripts/run-chaos.mjs",
    "backup:drill": "node scripts/backup-restore-drill.mjs",
    "build:desktop": "pnpm --filter @jarvis/desktop build",
    "verify:full": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:contract && pnpm test:security && pnpm fitness && pnpm test:chaos && pnpm backup:drill && pnpm build:desktop",
    "db:migrate": "pnpm --filter @jarvis/persistence db:migrate",
    "telemetry:verify": "tsx scripts/verify-observability.ts",
    "stack:up": "docker compose -f infrastructure/docker/local-server.compose.yml up -d",
    "stack:down": "docker compose -f infrastructure/docker/local-server.compose.yml down",
    "stack:reset": "docker compose -f infrastructure/docker/local-server.compose.yml down -v",
    "core:dev": "pnpm --filter @jarvis/core dev",
    "node:pki": "node scripts/node-pki.mjs",
    "node:runtime": "pnpm --filter @jarvis/core exec tsx src/node-cli.ts",
    "node:proof": "node scripts/node-proof.mjs",
    "gateway:dev": "pnpm --filter @jarvis/gateway dev",
    "display:dev": "pnpm exec tsx apps/display/src/main.ts",
    "voice:dev": "pnpm --filter @jarvis/voice dev",
    "voice:qualify": "pnpm --filter @jarvis/voice exec tsx src/main.ts --qualify",
    "voice:preflight": "node apps/voice/scripts/preflight.mjs",
    "vision:assets": "pnpm --filter @jarvis/vision assets",
    "vision:qualify": "pnpm --filter @jarvis/vision dev",
    "vision:dev": "pnpm --filter @jarvis/vision dev",
    "hardware:validate": "node scripts/hardware-validate.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.3",
    "zod": "^3.25.76"
  },
  "license": "UNLICENSED"
}
