        "additionalProperties": false
      },
      "riskClass": "LOW",
      "reversible": false,
      "simulatable": false,
      "verify": "verify",
      "idempotent": true,
      "sideEffects": [],
      "approvalPolicy": "default",
      "timeoutMs": 30000,
