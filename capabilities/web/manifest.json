{
  "id": "capabilities.web",
  "version": "1.1.0",
  "requiredScopes": ["web.fetch"],
  "trustTierMin": "owned-secure",
  "actions": [
    {
      "name": "fetch",
      "inputSchema": { "type": "object", "properties": { "url": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?:\\/\\/" }, "maxChars": { "type": "integer", "minimum": 500, "maximum": 12000 } }, "required": ["url"], "additionalProperties": false },
      "outputSchema": { "type": "object", "properties": { "finalUrl": { "type": "string" }, "status": { "type": "number" }, "contentType": { "type": "string" }, "title": { "type": "string" }, "text": { "type": "string" }, "contentSha256": { "type": "string" }, "fetchedAt": { "type": "string" }, "trust": { "const": "untrusted" } } },
      "riskClass": "LOW",
      "reversible": false,
      "simulatable": false,
      "verify": "verify",
      "idempotent": true,
      "sideEffects": [],
      "notes": [
        "GET only; Kernel egress enforces http(s), ports 80/443, public addresses after DNS and on every redirect, size/time/content-type limits, no cookies or credentials",
        "policy base.web.fetch = REQUIRE_APPROVAL; the bootstrap grant never proceeds without live operator approval",
        "response is tagged trust:untrusted; any Proposal derived from it is derivedFromUntrusted (ADR-0018)"
      ]
    }
  ]
}
