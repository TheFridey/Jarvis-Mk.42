          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "riskClass": "LOW",
      "reversible": false,
      "simulatable": false,
      "verify": "verify",
      "idempotent": true,
      "sideEffects": [],
      "approvalPolicy": "default",
      "timeoutMs": 30000,
      "verificationStrategy": {
        "kind": "world-read",
        "adapterRef": "search"
      },
      "declaredEgress": [
